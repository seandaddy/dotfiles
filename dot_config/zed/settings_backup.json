{
  "jupyter": {
    "python": {
      "enabled": true,
      "default_kernel": "python3",
      "kernelselection": "auto"
    },
    "r": {
      "enabled": true,
      "default_kernel": "ark",
      "kernelselection": "ark"
    }
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "version": "2"
  },
  "terminal": { "font_family": "JetBrainsMono Nerd Font" },
  "vim_mode": true,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 20,
  "buffer_font_size": 20,
  "theme": "Tokyo Night"
},
  "experimental.theme_overrides": {
   "background.appearance": "blurred"
   "background": "#00000060"
   "editor.background": "#00000060",
      "panel.background": "#00000060",
      "status_bar.background": "#00000060",
      "tab_bar.background": "#00000060",
      "tab.active_background": "#00000060",
      "tab.inactive_background": "#00000060",
      "terminal.background": "#00000060",
      "toolbar.background": "#00000060",
      "border": "#00000060",
      "title_bar.background": "#00000060",
      "title_bar.inactive_background": "#00000060",
      "title_bar.border": "#00000060",
      "title_bar.inactive_border": "#00000060",
      "scrollbar.track.background": "#00000060",
      "scrollbar.track.border": "#00000060",
      "scrollbar.thumb.background": "#00000060",
      "scrollbar.thumb.border": "#00000060",
      "editor.active_line.background": "#00000060",
      "editor.selection.background": "#00000060",
      "editor.gutter.background": "#00000060"
    }
}
