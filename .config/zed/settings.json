{
  "scrollbar": {
    "show": "never",
  },
  "relative_line_numbers": "enabled",
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "google",
      "model": "gemini-3-flash-preview",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "github-copilot": {
      "type": "registry",
    },
  },
  "jupyter": {
    "python": {
      "enabled": true,
      "default_kernel": "python3",
      "kernelselection": "auto",
    },
    "r": {
      "enabled": true,
      "default_kernel": "ark",
      "kernelselection": "ark",
    },
  },
  // "agent": {
  //   "default_model": {
  //     "provider": "copilot_chat",
  //     "model": "gpt-4o"
  //   }
  // },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
  },
  "vim_mode": true,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 20,
  "buffer_font_size": 20,
  "theme": "Tokyo Night",
